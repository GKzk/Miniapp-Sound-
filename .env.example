# .env.example
# REQUIRED: Get these from respective developer consoles
GEMINI_API_KEY=
LASTFM_API_KEY=
TELEGRAM_BOT_TOKEN=

# MUSIC PROVIDERS (STAGE 4C.1)
# SoundCloud public API only requires client_id for catalog search and signed stream resolution.
# (client_secret is not required for public playback and is not used).
SOUNDCLOUD_CLIENT_ID=

# OPTIONAL: Configure for local development (defaults to 3000)
# PORT=3000

# Set to 'true' in production
NODE_ENV=development
