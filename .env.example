# .env.example
# REQUIRED: Get these from respective developer consoles
GEMINI_API_KEY=
LASTFM_API_KEY=
TELEGRAM_BOT_TOKEN=

# MUSIC PROVIDERS (STAGE 4C)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# OPTIONAL: Configure for local development (defaults to 3000)
# PORT=3000

# Set to 'true' in production
NODE_ENV=development
